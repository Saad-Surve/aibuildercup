{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "web/out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "creator-studio-api",
          "region": "us-central1"
        }
      }
    ]
  }
}
