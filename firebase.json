{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "web/out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate"
          },
          { "key": "Pragma", "value": "no-cache" },
          { "key": "Vary", "value": "Authorization" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/projects/view/project/**",
        "destination": "/projects/view.html"
      },
      {
        "source": "/api/**",
        "run": {
          "serviceId": "creator-studio-api",
          "region": "us-central1"
        }
      }
    ]
  }
}
