# DEPLOYED config (Cloud Run env vars). Layer these over the base config in .env.example.
# Every LLM call runs on Gemini Enterprise Agent Platform (formerly Vertex AI) using the Cloud
# Run runtime service account's Application Default Credentials — no API key.
ENVIRONMENT=production
# "global" is the cheapest Gemini endpoint.
VERTEX_LOCATION=global
# Read-only demo account (see infra/RESOURCES.md). Comma-separated UIDs; the API refuses writes
# from them and the web client disables the controls.
READ_ONLY_USER_UIDS=demoCreatorHabeasCodus
# Passwordless demo login: the API mints a custom token for this UID (no public password).
DEMO_USER_UID=demoCreatorHabeasCodus
# Stronger models for the deployed service.
MODEL_REVIEWER=gemini-3.8-flash
# Independent finding verification. Blank MODEL_ADJUDICATOR follows MODEL_REVIEWER.
# Set ADJUDICATOR_INPUT_PRICE_PER_MTOK / ADJUDICATOR_OUTPUT_PRICE_PER_MTOK for a different tier.
# MODEL_ADJUDICATOR=gemini-3.8-flash
MAX_ADJUDICATOR_CALLS=12
MAX_CONFLICT_CALLS=4
MODEL_ORCHESTRATOR=gemini-3.8-flash
MODEL_WRITER=gemini-3.8-flash
MODEL_LOCALIZATION=gemini-3.8-flash
MODEL_TRANSCRIPT_REPAIR=gemini-3.8-flash
# Predicted-interest curve signals. Keep this pinned: the bundled interest model was
# trained on this model's ratings (app/assets/interest/model.json).
MODEL_INTEREST_SIGNALS=gemini-3.1-flash-lite
INTEREST_CURVE_ENABLED=true
# Alternatives / short span rewrites stay on the cheap flash-lite tier.
MODEL_SUGGEST=gemini-3.1-flash-lite
# Prices for the models above (USD per 1M tokens), so cost estimates stay accurate.
# 0.75 / 3.75 is introductory pricing through 2026-12-31; it becomes 1.50 / 7.50 on 2027-01-01.
LLM_INPUT_PRICE_PER_MTOK=0.75
LLM_OUTPUT_PRICE_PER_MTOK=3.75
# Deployed-only: authenticate the internal Pub/Sub push. Set PUBSUB_PUSH_AUDIENCE to the API's
# public URL (no trailing slash) and PUBSUB_PUSH_SERVICE_ACCOUNT to the push subscription's SA.
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=

# --- YouTube connector / publishing ----------------------------------------------------
# The OAuth client id/secret come from Secret Manager (`youtube-oauth-client-id` /
# `youtube-oauth-client-secret`) via the deploy workflow, not from this file. The OAuth client
# MUST live in this project (`habeas-codus`): YouTube Data API calls are quota-attributed to the
# project that owns the client, so a client created in another project fails with
# "YouTube Data API v3 has not been used in project <number>".
# GOOGLE_OAUTH_CLIENT_ID=      # Secret Manager
# GOOGLE_OAUTH_CLIENT_SECRET=  # Secret Manager
# Origins used to build the OAuth redirect and the post-callback landing URL.
WEB_BASE_URL=https://habeas-codus.web.app
API_PUBLIC_BASE_URL=https://creator-studio-api-3sim77rugq-uc.a.run.app
# Cap for the publish worker's local temp disk (Cloud Run's default writable disk is ~2 GB).
PUBLISH_MAX_STAGE_BYTES=2000000000

# Use a validated, pre-indexed backend corpus; false uses actual connected accounts.
CREATOR_PRESET_ENABLED=false
CREATOR_PRESET_OBJECT=

MODEL_VIDEO=veo-3.1-fast-generate-001

# Packaging plans use the cheap structured-output tier. Paid clips are explicit and capped.
MODEL_PACKAGING=gemini-3.1-flash-lite
VISUAL_INSERT_MAX_PAID_RENDERS=2
VIDEOGEN_PRICE_PER_SECOND_USD=0.40
VIDEOGEN_POLL_TIMEOUT_SECONDS=480

# Editorial consolidation: unset model/prices follow the reviewers, <=3 calls/run.
# MODEL_EDITOR=gemini-3.8-flash
MAX_EDITOR_CALLS=3
EDITOR_THINKING_LEVEL=low
# EDITOR_INPUT_PRICE_PER_MTOK=0.75
# EDITOR_OUTPUT_PRICE_PER_MTOK=3.75
