ENVIRONMENT=local
PROJECT_ID=habeas-codus
REGION=us-central1
FIREBASE_PROJECT_ID=habeas-codus
MEDIA_BUCKET=habeas-codus-media
CORPUS_BUCKET=habeas-codus-corpus
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","https://habeas-codus.web.app","https://habeas-codus.firebaseapp.com"]
# Read-only demo account(s). Comma-separated UIDs (or a JSON array) that may read everything
# they own but never write: the API rejects their POST/PUT/PATCH/DELETE with a 403 and the web
# client disables the matching controls. Seed the account from a real one with
# `uv run python scripts/copy_user_content.py --source <uid> --dest <uid> --replace`.
READ_ONLY_USER_UIDS=
# Shared read-only demo account. When set, POST /api/demo/session mints a Firebase custom
# token for this UID so the browser never holds a password. Must also be in READ_ONLY_USER_UIDS.
DEMO_USER_UID=
# LOCAL config. LLM calls run on Gemini Enterprise Agent Platform (formerly Vertex AI) using
# Application Default Credentials (locally: `gcloud auth application-default login`). The
# deployed service uses the stronger models in .env.deploy.example.
# Agent Platform location; "global" is the cheapest endpoint.
VERTEX_LOCATION=global
# Cheap flash-lite tier for local runs.
MODEL_REVIEWER=gemini-3.1-flash-lite
# Independent finding verification. Blank MODEL_ADJUDICATOR follows MODEL_REVIEWER.
# Set ADJUDICATOR_INPUT_PRICE_PER_MTOK / ADJUDICATOR_OUTPUT_PRICE_PER_MTOK for a different tier.
# MODEL_ADJUDICATOR=gemini-3.1-flash-lite
MAX_ADJUDICATOR_CALLS=12
MAX_CONFLICT_CALLS=4
MODEL_ORCHESTRATOR=gemini-3.1-flash-lite
# Main draft generation + the writing-partner chat: prose quality needs the stronger tier.
MODEL_WRITER=gemini-3.8-flash
# Alternatives / short span rewrites stay on the cheap flash-lite tier.
MODEL_SUGGEST=gemini-3.1-flash-lite
# Localization cultural-adaptation pass (second translation stage).
MODEL_LOCALIZATION=gemini-3.1-flash-lite
# Post-Chirp transcript cleanup: conservative recognition-error fixes + speaker inference.
MODEL_TRANSCRIPT_REPAIR=gemini-3.1-flash-lite
# Predicted-interest curve signals. Keep this pinned: the bundled interest model was
# trained on this model's ratings (app/assets/interest/model.json).
MODEL_INTEREST_SIGNALS=gemini-3.1-flash-lite
INTEREST_CURVE_ENABLED=true
# Post-review examples from the creator's own indexed text library (0 disables).
# Cosine 0.65 is a provisional relevance cutoff, not calibrated confidence.
FINDING_LIBRARY_MAX_FINDINGS=8
FINDING_LIBRARY_TOP_K=3
FINDING_LIBRARY_MIN_SIMILARITY=0.65
FINDING_LIBRARY_SELECTION_ENABLED=true
EMBEDDING_TEXT_PRICE_PER_MTOK=0.20
# Off to keep the raw Chirp output (useful for comparing before/after).
TRANSCRIPT_REPAIR_ENABLED=true
TRANSCRIPT_REPAIR_MAX_CHARS=12000
# Prices for the models above (USD per 1M tokens) so cost estimates stay accurate.
LLM_INPUT_PRICE_PER_MTOK=0.25
LLM_OUTPUT_PRICE_PER_MTOK=1.50
# Retry transient LLM 429/5xx before falling back.
LLM_MAX_ATTEMPTS=4
LLM_RETRY_BASE_SECONDS=0.5
MODEL_IMAGE=gemini-3.1-flash-image
MODEL_VIDEO=veo-3.1-fast-generate-001
# Chirp 3 does multilingual, language-agnostic transcription; it is GA on the `us`
# multi-region, not in us-central1.
MODEL_STT=chirp_3
STT_REGION=us
# STT V2 cannot auto-detect AAC in MP4/MOV/M4A, so those use explicit decoding with these
# defaults (44.1 kHz stereo, matching creator/social video).
STT_SAMPLE_RATE_HZ=44100
STT_AUDIO_CHANNEL_COUNT=2
# Label words with a speaker index (Chirp 3 diarization) and show speaker turns in the UI.
STT_ENABLE_DIARIZATION=true
# Submission 429 attempts / consecutive transient polling failures. Polling reuses one name.
STT_MAX_ATTEMPTS=4
STT_RETRY_BASE_SECONDS=3.0
STT_RETRY_MAX_SECONDS=30.0
STT_POLL_INTERVAL_SECONDS=5.0
STT_RPC_TIMEOUT_SECONDS=30.0
# Total recognition deadline per worker invocation, including deliberate audio/diarization retries.
STT_JOB_TIMEOUT_SECONDS=600.0
MAX_REVIEWER_CONCURRENCY=4
MAX_PROJECT_COST_USD=5.0
# Reviewer footage tools (FFmpeg): the reviewer calls extract_frame / cut_clip during its
# own review (function calling) and grades with the footage attached. Bounded per reviewer
# call: MAX_VISUAL_CONTEXT_REQUESTS is the total tool calls, VISUAL_TOOL_MAX_ROUNDS is how
# many tool round-trips are allowed. Needs ffmpeg on PATH.
REVIEW_VISUAL_TOOLS_ENABLED=true
MAX_VISUAL_CONTEXT_REQUESTS=3
VISUAL_TOOL_MAX_ROUNDS=2
VISUAL_CLIP_WINDOW_SECONDS=5
FFMPEG_PATH=ffmpeg
# ffprobe reads the true media duration so corrupt STT timestamps (words past the video's
# end) are dropped before segmenting. Same package as ffmpeg.
FFPROBE_PATH=ffprobe
# Caption burn-in (Export > "Burn captions onto video"): sources up to this size are
# staged to the worker's temp dir before encoding, which probes reliably and seeks fast.
# Larger sources stream from a signed URL. Fonts are bundled in app/assets/fonts.
CAPTION_MAX_SOURCE_DOWNLOAD_BYTES=300000000
# Truth reviewer: verify hard claims against Google Search instead of model memory. Gemini 3
# only; billed per search query after 5k free/month, so only truth_evidence opts in.
TRUTH_GROUNDING_ENABLED=true
MAX_UPLOAD_SIZE_BYTES=524288000
UPLOAD_URL_TTL_SECONDS=900
# Optional. With plain user ADC, signed upload URLs are minted for this service account via IAM
# signBlob. Defaults to creator-studio-api@<PROJECT_ID>.iam.gserviceaccount.com.
STORAGE_SIGNING_SERVICE_ACCOUNT=
# Internal Pub/Sub push verification. Set PUBSUB_PUSH_AUDIENCE to the API's public URL (no
# trailing slash) so the GCS-finalized push is authenticated; the infra push subscription mints
# OIDC tokens as PUBSUB_PUSH_SERVICE_ACCOUNT. Leave blank locally.
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=

# --- YouTube connector / publishing ----------------------------------------------------
# The browser and API origins, used to build the OAuth redirect and post-callback landing URL.
WEB_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:8080
# Google OAuth client (Web application) from the GCP console. The redirect URI registered on it
# must be API_PUBLIC_BASE_URL + /api/connections/youtube/oauth/callback. Create the client, then
# copy the id/secret here (development) or into Secret Manager (deployed).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional explicit redirect; derived from API_PUBLIC_BASE_URL when blank.
GOOGLE_OAUTH_REDIRECT_URI=
# --- Reddit connector ------------------------------------------------------------------
# Reddit app (web type) from reddit.com/prefs/apps. The redirect URI registered on it
# must be API_PUBLIC_BASE_URL + /api/connections/reddit/oauth/callback. Copy the id/secret
# here (development) or into Secret Manager (deployed). Free tier: 100 calls/min, personal use.
REDDIT_OAUTH_CLIENT_ID=
REDDIT_OAUTH_CLIENT_SECRET=
# Optional explicit redirect; derived from API_PUBLIC_BASE_URL when blank.
REDDIT_OAUTH_REDIRECT_URI=
# Local token encryption. Set to any passphrase to encrypt OAuth tokens with a derived key
# instead of Cloud KMS (which needs roles/cloudkms.cryptoKeyEncrypterDecrypter). Leave blank in
# production so KMS is used.
OAUTH_TOKEN_ENCRYPTION_KEY=local-dev-token-key
# KMS key used in production; defaults to
# projects/<PROJECT_ID>/locations/<REGION>/keyRings/creator-studio-keyring/cryptoKeys/user-token-key
KMS_TOKEN_KEY_NAME=
# Refuse to stage a source larger than this for a YouTube upload.
PUBLISH_MAX_SOURCE_BYTES=8000000000
# Smaller cap for the publish worker's local temp disk (Cloud Run's default writable disk is
# ~2 GB). Raise only after raising the Cloud Run disk size.
PUBLISH_MAX_STAGE_BYTES=2000000000

# Use a validated, pre-indexed backend corpus; false uses actual connected accounts.
CREATOR_PRESET_ENABLED=false
CREATOR_PRESET_OBJECT=

# Packaging plans use the cheap structured-output tier. Paid clips are explicit and capped.
MODEL_PACKAGING=gemini-3.1-flash-lite
VISUAL_INSERT_MAX_PAID_RENDERS=2
VIDEOGEN_PRICE_PER_SECOND_USD=0.40
VIDEOGEN_POLL_TIMEOUT_SECONDS=480

# Editorial consolidation: unset model/prices follow the reviewers, <=3 calls/run.
# MODEL_EDITOR=gemini-3.8-flash
MAX_EDITOR_CALLS=3
EDITOR_THINKING_LEVEL=medium
# EDITOR_INPUT_PRICE_PER_MTOK=0.75
# EDITOR_OUTPUT_PRICE_PER_MTOK=3.75
