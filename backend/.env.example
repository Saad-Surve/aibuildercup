ENVIRONMENT=local
PROJECT_ID=habeas-codus
REGION=us-central1
FIREBASE_PROJECT_ID=habeas-codus
MEDIA_BUCKET=habeas-codus-media
CORPUS_BUCKET=habeas-codus-corpus
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","https://habeas-codus.web.app","https://habeas-codus.firebaseapp.com"]
# LOCAL config. LLM calls run on Gemini Enterprise Agent Platform (formerly Vertex AI) using
# Application Default Credentials (locally: `gcloud auth application-default login`). The
# deployed service uses the stronger models in .env.deploy.example.
# Agent Platform location; "global" is the cheapest endpoint.
VERTEX_LOCATION=global
# Cheap flash-lite tier for local runs.
MODEL_REVIEWER=gemini-3.1-flash-lite
MODEL_ORCHESTRATOR=gemini-3.1-flash-lite
MODEL_WRITER=gemini-3.1-flash-lite
# Localization cultural-adaptation pass (second translation stage).
MODEL_LOCALIZATION=gemini-3.1-flash-lite
# Post-Chirp transcript cleanup: conservative recognition-error fixes + speaker inference.
MODEL_TRANSCRIPT_REPAIR=gemini-3.1-flash-lite
# Off to keep the raw Chirp output (useful for comparing before/after).
TRANSCRIPT_REPAIR_ENABLED=true
TRANSCRIPT_REPAIR_MAX_CHARS=12000
# Prices for the models above (USD per 1M tokens) so cost estimates stay accurate.
LLM_INPUT_PRICE_PER_MTOK=0.25
LLM_OUTPUT_PRICE_PER_MTOK=1.50
# Retry transient LLM 429/5xx before falling back.
LLM_MAX_ATTEMPTS=4
LLM_RETRY_BASE_SECONDS=0.5
MODEL_IMAGE=gemini-3.1-flash-image
MODEL_VIDEO=veo-3.1-fast
# Chirp 3 does multilingual, language-agnostic transcription; it is GA on the `us`
# multi-region, not in us-central1.
MODEL_STT=chirp_3
STT_REGION=us
# STT V2 cannot auto-detect AAC in MP4/MOV/M4A, so those use explicit decoding with these
# defaults (44.1 kHz stereo, matching creator/social video).
STT_SAMPLE_RATE_HZ=44100
STT_AUDIO_CHANNEL_COUNT=2
# Label words with a speaker index (Chirp 3 diarization) and show speaker turns in the UI.
STT_ENABLE_DIARIZATION=true
MAX_REVIEWER_CONCURRENCY=4
MAX_PROJECT_COST_USD=5.0
# Reviewer footage tools (FFmpeg): the reviewer calls extract_frame / cut_clip during its
# own review (function calling) and grades with the footage attached. Bounded per reviewer
# call: MAX_VISUAL_CONTEXT_REQUESTS is the total tool calls, VISUAL_TOOL_MAX_ROUNDS is how
# many tool round-trips are allowed. Needs ffmpeg on PATH.
REVIEW_VISUAL_TOOLS_ENABLED=true
MAX_VISUAL_CONTEXT_REQUESTS=3
VISUAL_TOOL_MAX_ROUNDS=2
VISUAL_CLIP_WINDOW_SECONDS=5
FFMPEG_PATH=ffmpeg
# ffprobe reads the true media duration so corrupt STT timestamps (words past the video's
# end) are dropped before segmenting. Same package as ffmpeg.
FFPROBE_PATH=ffprobe
# Caption burn-in (Export > "Burn captions onto video"): sources up to this size are
# staged to the worker's temp dir before encoding, which probes reliably and seeks fast.
# Larger sources stream from a signed URL. Fonts are bundled in app/assets/fonts.
CAPTION_MAX_SOURCE_DOWNLOAD_BYTES=300000000
# Truth reviewer: verify hard claims against Google Search instead of model memory. Gemini 3
# only; billed per search query after 5k free/month, so only truth_evidence opts in.
TRUTH_GROUNDING_ENABLED=true
MAX_UPLOAD_SIZE_BYTES=524288000
UPLOAD_URL_TTL_SECONDS=900
# Optional. With plain user ADC, signed upload URLs are minted for this service account via IAM
# signBlob. Defaults to creator-studio-api@<PROJECT_ID>.iam.gserviceaccount.com.
STORAGE_SIGNING_SERVICE_ACCOUNT=
# Internal Pub/Sub push verification. Set PUBSUB_PUSH_AUDIENCE to the API's public URL (no
# trailing slash) so the GCS-finalized push is authenticated; the infra push subscription mints
# OIDC tokens as PUBSUB_PUSH_SERVICE_ACCOUNT. Leave blank locally.
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=
