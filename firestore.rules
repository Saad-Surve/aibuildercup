rules_version = '2';

// All application data is read and written by the FastAPI backend through the Admin SDK,
// which bypasses these rules. The browser must never touch Firestore directly.
// See docs/technical-design/frontend-plan.md: "The frontend should not use Firestore
// directly for sensitive data."
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
